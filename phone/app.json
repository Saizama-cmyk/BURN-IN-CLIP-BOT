{
  "expo": {
    "name": "BURN-IN",
    "slug": "burn-in-remote",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-ios.png",
    "scheme": "burnin",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070708",
    "splash": {
      "image": "./assets/icon-ios.png",
      "resizeMode": "contain",
      "backgroundColor": "#070708"
    },
    "ios": {
      "bundleIdentifier": "os.spike.burnin.remote",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "BURN-IN Remote talks to the BURN-IN app running on your PC over your local network.",
        "UIBackgroundModes": []
      },
      "entitlements": {
        "com.apple.developer.kernel.increased-memory-limit": true
      },
      "icon": "./assets/icon-ios.png"
    },
    "android": {
      "package": "os.spike.burnin.remote",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-adaptive.png",
        "backgroundColor": "#070708"
      },
      "icon": "./assets/icon-ios.png",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25",
            "minSdkVersion": 26
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock with Face ID so nobody else can open your desk or your chats."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach photos and videos to a message for the assistant.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-document-picker"
    ],
    "notification": {
      "icon": "./assets/icon-notification.png",
      "color": "#070708"
    },
    "web": {
      "favicon": "./assets/icon-ios.png"
    }
  }
}
